# A QGroundControl survey plan flown over central Berlin.
#
# The plan is a lawnmower pattern at 380 m above the home position, which is
# the sort of thing a mapping sortie actually looks like. Both file formats
# are in missions/ and describe the same flight, so either can be loaded:
#
#   --mission missions/berlin-survey.plan        (QGC native JSON)
#   --mission missions/berlin-survey.waypoints   (QGC WPL 110 text)
#
# Fetch the data with:
#   scripts/fetch_dem.py --origin 52.5163,13.3777 --extent 1200
#   scripts/fetch_map.py --source esri --origin 52.5163,13.3777 --extent 1200 \
#       --zoom 18 --max-tiles 800 --out data/berlin_sat.map
#   scripts/fetch_map.py --source basemapde --origin 52.5163,13.3777 --extent 1200 \
#       --zoom 18 --max-tiles 800 --out data/berlin_map.map

name              BERLIN - QGC SURVEY
origin            52.5163,13.3777
extent            1200

dem               data/dem
map-satellite     esri
map-street        basemapde
geoid-separation  39.5

mission           missions/berlin-survey.plan
